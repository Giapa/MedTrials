{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "oxfmt src/ evaluation/",
    "lint": "oxlint src evaluation",
    "format:check": "oxfmt --check src/ evaluation/",
    "evaluate:greek": "vitest run evaluation/greek-search.eval.spec.ts --reporter=verbose --silent=false"
  },
  "dependencies": {
    "vue": "^3.5.42",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "29.1.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.93.0",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
